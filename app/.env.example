# Flutter App Environment Variables
# Copy to .env and use with flutter_dotenv

# API Base URL (Cloudflare Workers)
API_BASE_URL=https://kisaan-ml-api.your-subdomain.workers.dev/api/v1

# Render WebSocket URL (for real-time updates)
WS_BASE_URL=wss://kisaan-ml-render.your-domain.com/ws

# Supabase (optional - for auth/user data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps (for location picker)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Sentry (error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# App Configuration
APP_NAME=Kisaan-ML
APP_VERSION=1.0.0
BUILD_NUMBER=1