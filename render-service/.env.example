# Render Web Service Environment Variables
# Copy to .env and fill in your values

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=postgresql://kisaan:kisaan123@localhost:5432/kisaan_ml

# Cloudflare R2 (for model storage)
CF_R2_ACCOUNT_ID=your_account_id
CF_R2_ACCESS_KEY_ID=your_access_key
CF_R2_SECRET_ACCESS_KEY=your_secret_key
CF_R2_BUCKET=kisaan-ml-models

# Cloudflare Workers API (for async inference)
CF_WORKERS_API_URL=https://kisaan-ml-api.your-subdomain.workers.dev

# PIB RSS Feed
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&RegId=3

# Planetary Computer
PLANETARY_COMPUTER_API=https://api.planetarycomputer.microsoft.com/api/stac/v1

# Logging
LOG_LEVEL=info